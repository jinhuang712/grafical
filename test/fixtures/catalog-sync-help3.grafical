<diagram> {
  format: 1
  title: "catalog-sync and catalog-api"
  subtitle: "Two Go services, coupled only by the shared MongoDB."
  caption: "Not shown: the full-load trigger (unknown), production database names, whether production runs a separate relay pod (unknown), and the full list of catalog-api callers."
  density: normal
}

<layer> row-callers {
}

<layer> row-broker {
}

<layer> row-services {
}

<layer> row-kafka {
}

<layer> row-outside {
}

<layer> row-stores {
}

<group> grp-sync {
}

<order> layers {
  of: @diagram
  axis: down
  items:
    @row-callers
    @row-broker
    @row-services
    @row-kafka
    @row-outside
    @row-stores
}

<order> row-callers-order {
  of: @row-callers
  axis: across
  items:
    @pub
    @ops
    @readers
}

<order> row-broker-order {
  of: @row-broker
  axis: across
  items:
    @upstream
}

<order> row-services-order {
  of: @row-services
  axis: across
  items:
    @relay
    @sync
    @api
}

<order> row-kafka-order {
  of: @row-kafka
  axis: across
  items:
    @goods-topics
    @retry-topic
}

<order> row-outside-order {
  of: @row-outside
  axis: across
  items:
    @geo
    @auth
    @i18n
    @campaign
}

<order> row-stores-order {
  of: @row-stores
  axis: across
  items:
    @pg
    @redis
    @mongo
}

<node> pub {
  type: @service
  text: "Publishers"
  sublabel: "inventory, pricing, merchant"
  layer: @row-callers
}

<node> ops {
  type: @actor
  text: "Operators"
  sublabel: "admin routes, other services"
  layer: @row-callers
}

<node> readers {
  type: @actor
  text: "Storefront"
  sublabel: "promotions and others"
  layer: @row-callers
}

<node> upstream {
  type: @queue
  text: "Upstream topics"
  sublabel: "item, variant, offer, search"
  layer: @row-broker
}

<node> relay {
  type: @service
  text: "catalog-relay"
  sublabel: "tier 1, :7101"
  layer: @row-services
  group: @grp-sync
}

<node> sync {
  type: @service
  text: "catalog-sync"
  sublabel: "tier 2, :7102, embedded relay"
  layer: @row-services
  group: @grp-sync
}

<node> api {
  type: @service
  text: "catalog-api"
  sublabel: "gRPC :7190, HTTP :8080"
  layer: @row-services
}

<node> goods-topics {
  type: @queue
  text: "Line topics"
  sublabel: "goods_v1, tickets_v1"
  layer: @row-kafka
}

<node> retry-topic {
  type: @queue
  text: "Retry topic"
  sublabel: "catalog_retry_v1"
  layer: @row-kafka
}

<node> geo {
  type: @service
  text: "geo-svc"
  sublabel: "region tree"
  layer: @row-outside
}

<node> auth {
  type: @service
  text: "auth-svc"
  sublabel: "service auth check"
  layer: @row-outside
}

<node> i18n {
  type: @service
  text: "i18n-svc"
  sublabel: "translated text"
  layer: @row-outside
}

<node> campaign {
  type: @service
  text: "campaign-svc"
  sublabel: "campaign tags"
  layer: @row-outside
}

<node> pg {
  type: @store
  text: "Postgres replicas"
  sublabel: "goods, tickets"
  layer: @row-stores
}

<node> redis {
  type: @store
  text: "Redis"
  sublabel: "name cache, 10 min"
  layer: @row-stores
}

<node> mongo {
  type: @store
  text: "MongoDB"
  sublabel: "catalog, inventory, DLQ"
  layer: @row-stores
  emphasis: true
}

<edge> pub->upstream {
  from: @pub
  to: @upstream
  type: @async
}

<edge> upstream->relay {
  from: @upstream
  to: @relay
  type: @async
}

<edge> relay->goods-topics {
  from: @relay
  to: @goods-topics
  type: @async
}

<edge> goods-topics->sync {
  from: @goods-topics
  to: @sync
  type: @async
}

<edge> sync->retry-topic {
  from: @sync
  to: @retry-topic
  type: @async
}

<edge> retry-topic->sync {
  from: @retry-topic
  to: @sync
  type: @async
}

<edge> sync->mongo {
  from: @sync
  to: @mongo
  type: @call
}

<edge> sync->pg {
  from: @sync
  to: @pg
  type: @call
}

<edge> sync->redis {
  from: @sync
  to: @redis
  type: @call
}

<edge> sync->geo {
  from: @sync
  to: @geo
  type: @call
}

<edge> sync->i18n {
  from: @sync
  to: @i18n
  type: @call
}

<edge> sync->auth {
  from: @sync
  to: @auth
  type: @call
}

<edge> ops->sync {
  from: @ops
  to: @sync
  type: @call
}

<edge> readers->api {
  from: @readers
  to: @api
  type: @call
}

<edge> api->mongo {
  from: @api
  to: @mongo
  type: @call
}

<edge> api->campaign {
  from: @api
  to: @campaign
  type: @call
}

<edge> api->i18n {
  from: @api
  to: @i18n
  type: @call
}

<label> row-callers-label {
  on: @row-callers
  text: "Callers"
}

<label> row-broker-label {
  on: @row-broker
  text: "Broker"
}

<label> row-services-label {
  on: @row-services
  text: "Services"
}

<label> row-kafka-label {
  on: @row-kafka
  text: "Kafka"
}

<label> row-outside-label {
  on: @row-outside
  text: "Outside services"
}

<label> row-stores-label {
  on: @row-stores
  text: "Stores"
}

<label> grp-sync-label {
  on: @grp-sync
  text: "catalog-sync"
  sublabel: "Catalog team, Go"
}

<label> pub->upstream-label {
  on: @pub->upstream
  text: "publish"
}

<label> upstream->relay-label {
  on: @upstream->relay
  text: "consume"
}

<label> relay->goods-topics-label {
  on: @relay->goods-topics
  text: "produce"
}

<label> goods-topics->sync-label {
  on: @goods-topics->sync
  text: "consume"
}

<label> sync->retry-topic-label {
  on: @sync->retry-topic
  text: "failed"
}

<label> retry-topic->sync-label {
  on: @retry-topic->sync
  text: "retry"
}

<label> sync->mongo-label {
  on: @sync->mongo
  text: "persist"
}

<label> sync->pg-label {
  on: @sync->pg
  text: "read"
}

<label> sync->redis-label {
  on: @sync->redis
  text: "cache"
}

<label> sync->geo-label {
  on: @sync->geo
  text: "HTTP GET"
}

<label> sync->i18n-label {
  on: @sync->i18n
  text: "HTTP GET"
}

<label> sync->auth-label {
  on: @sync->auth
  text: "auth check"
}

<label> ops->sync-label {
  on: @ops->sync
  text: "admin HTTP"
}

<label> readers->api-label {
  on: @readers->api
  text: "read"
}

<label> api->mongo-label {
  on: @api->mongo
  text: "read"
}

<label> api->campaign-label {
  on: @api->campaign
  text: "tags"
}

<label> api->i18n-label {
  on: @api->i18n
  text: "campaign text"
}

<legend> {
  dashed: "async, via a topic"
}
