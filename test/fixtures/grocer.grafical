<diagram> {
  format: 1
  title: "grocer architecture"
  subtitle: "Customer, warehouse and courier apps call APIs that share Kafka events and per-service stores."
  caption: "Not shown: team ownership, retries, the warehouse network and internal auth between services."
  density: normal
}

<layer> row-callers {
}

<layer> row-edge {
}

<layer> row-api {
}

<layer> row-svc {
}

<layer> row-jobs {
}

<layer> row-bus {
}

<layer> row-db {
}

<layer> row-cache {
}

<layer> row-objects {
}

<layer> row-ext {
}

<order> layers {
  of: @diagram
  axis: down
  items:
    @row-callers
    @row-edge
    @row-api
    @row-svc
    @row-jobs
    @row-bus
    @row-db
    @row-cache
    @row-objects
    @row-ext
}

<order> row-callers-order {
  of: @row-callers
  axis: across
  items:
    @customers
    @picker-app
    @courier-app
    @care-desk
    @partner-feeds
}

<order> row-edge-order {
  of: @row-edge
  axis: across
  items:
    @cdn
    @api-gateway
    @identity-svc
}

<order> row-api-order {
  of: @row-api
  axis: across
  items:
    @storefront-bff
    @picking-api
    @courier-api
    @care-api
}

<order> row-svc-order {
  of: @row-svc
  axis: across
  items:
    @search-api
    @cart-svc
    @catalog-api
    @pricing-svc
    @orders-api
    @payments-svc
    @stock-svc
    @recommender
    @eta-svc
}

<order> row-jobs-order {
  of: @row-jobs
  axis: across
  items:
    @feed-importer
    @indexer
    @wave-planner
    @route-planner
    @invoicer
    @push-svc
    @mailer
    @label-printer
}

<order> row-bus-order {
  of: @row-bus
  axis: across
  items:
    @events
}

<order> row-db-order {
  of: @row-db
  axis: across
  items:
    @identity-db
    @catalog-db
    @pricing-db
    @orders-db
    @payments-db
    @stock-db
    @waves-db
    @routes-db
    @tickets-db
}

<order> row-cache-order {
  of: @row-cache
  axis: across
  items:
    @session-redis
    @cart-redis
    @reco-cache
    @eta-redis
    @search-index
}

<order> row-objects-order {
  of: @row-objects
  axis: across
  items:
    @image-store
    @invoice-store
    @analytics-lake
}

<order> row-ext-order {
  of: @row-ext
  axis: across
  items:
    @card-gateway
    @maps-api
    @mail-provider
    @push-provider
}

<node> customers {
  type: @actor
  text: "Shoppers"
  sublabel: "web, mobile app"
