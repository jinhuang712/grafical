  on: @auth-svc->auth-redis
  text: "sessions"
}

<label> booking-api->events-label {
  on: @booking-api->events
  text: "trip-requested, trip-cancelled"
}

<label> driver-socket->events-label {
  on: @driver-socket->events
  text: "locations"
}

<label> matcher->driver-socket-label {
  on: @matcher->driver-socket
