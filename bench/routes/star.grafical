<diagram> {
  format: 1
  title: "star"
}

<layer> r0 {
}

<layer> r1 {
}

<layer> r2 {
}

<order> layers {
  of: @diagram
  axis: down
  items:
    @r0
    @r1
    @r2
}

<order> r0-order {
  of: @r0
  axis: across
  items:
    @a
    @b
    @c
}

<order> r1-order {
  of: @r1
  axis: across
  items:
    @d
}

<order> r2-order {
  of: @r2
  axis: across
  items:
    @e
    @f
    @g
}

<node> a {
  type: @service
  text: "A"
  layer: @r0
}

<node> b {
  type: @service
  text: "B"
  layer: @r0
}

<node> c {
  type: @service
  text: "C"
  layer: @r0
}

<node> d {
  type: @service
  text: "D"
  layer: @r1
}

<node> e {
  type: @service
  text: "E"
  layer: @r2
}

<node> f {
  type: @service
  text: "F"
  layer: @r2
}

<node> g {
  type: @service
  text: "G"
  layer: @r2
}

<edge> a-d {
  from: @a
  to: @d
  type: @call
}

<edge> b-d {
  from: @b
  to: @d
  type: @call
}

<edge> c-d {
  from: @c
  to: @d
  type: @call
}

<edge> d-e {
  from: @d
  to: @e
  type: @call
}

<edge> d-f {
  from: @d
  to: @f
  type: @call
}

<edge> d-g {
  from: @d
  to: @g
  type: @call
}
