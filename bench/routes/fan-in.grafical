<diagram> {
  format: 1
  title: "fan-in"
  density: normal
}

<layer> r0 {
}

<layer> r1 {
}

<order> layers {
  of: @diagram
  axis: down
  items:
    @r0
    @r1
}

<order> r0-order {
  of: @r0
  axis: across
  items:
    @a
    @b
    @c
    @d
}

<order> r1-order {
  of: @r1
  axis: across
  items:
    @e
}

<node> a {
  type: @service
  text: "A"
  layer: @r0
}

<node> b {
  type: @service
  text: "B"
  layer: @r0
}

<node> c {
  type: @service
  text: "C"
  layer: @r0
}

<node> d {
  type: @service
  text: "D"
  layer: @r0
}

<node> e {
  type: @service
  text: "E"
  layer: @r1
}

<edge> a->e {
  from: @a
  to: @e
  type: @call
}

<edge> b->e {
  from: @b
  to: @e
  type: @call
}

<edge> c->e {
  from: @c
  to: @e
  type: @call
}

<edge> d->e {
  from: @d
  to: @e
  type: @call
}
