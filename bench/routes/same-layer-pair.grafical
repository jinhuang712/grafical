<diagram> {
  format: 1
  title: "same-layer-pair"
}

<layer> r0 {
}

<layer> r1 {
}

<order> layers {
  of: @diagram
  axis: down
  items:
    @r0
    @r1
}

<order> r0-order {
  of: @r0
  axis: across
  items:
    @a
    @b
    @c
}

<order> r1-order {
  of: @r1
  axis: across
  items:
    @d
    @e
}

<node> a {
  type: @service
  text: "A"
  layer: @r0
}

<node> b {
  type: @service
  text: "B"
  layer: @r0
}

<node> c {
  type: @service
  text: "C"
  layer: @r0
}

<node> d {
  type: @service
  text: "D"
  layer: @r1
}

<node> e {
  type: @service
  text: "E"
  layer: @r1
}

<edge> a-c {
  from: @a
  to: @c
  type: @call
}

<edge> c-a {
  from: @c
  to: @a
  type: @call
}

<edge> a-d {
  from: @a
  to: @d
  type: @call
}

<edge> b-e {
  from: @b
  to: @e
  type: @call
}
