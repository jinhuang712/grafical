<diagram> {
  format: 1
  title: "waterfall"
}

<layer> r0 {
}

<order> layers {
  of: @diagram
  axis: down
  items:
    @r0
}

<order> r0-order {
  of: @r0
  axis: across
  items:
    @a
}

<node> a {
  type: @service
  text: "A"
  layer: @r0
}

<node> b {
  type: @service
  text: "B"
  from: @a
  down: 1
  right: 1
}

<node> c {
  type: @service
  text: "C"
  from: @b
  down: 1
  right: 1
}

<node> d {
  type: @service
  text: "D"
  from: @c
  down: 1
  right: 1
}

<node> e {
  type: @service
  text: "E"
  from: @d
  down: 1
  right: 1
}

<edge> a-b {
  from: @a
  to: @b
  type: @call
}

<edge> b-c {
  from: @b
  to: @c
  type: @call
}

<edge> c-d {
  from: @c
  to: @d
  type: @call
}

<edge> d-e {
  from: @d
  to: @e
  type: @call
}
