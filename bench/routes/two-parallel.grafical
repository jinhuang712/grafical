<diagram> {
  format: 1
  title: "two-parallel"
}

<layer> r0 {
}

<layer> r1 {
}

<order> layers {
  of: @diagram
  axis: down
  items:
    @r0
    @r1
}

<order> r0-order {
  of: @r0
  axis: across
  items:
    @a
}

<order> r1-order {
  of: @r1
  axis: across
  items:
    @b
}

<node> a {
  type: @service
  text: "A"
  layer: @r0
}

<node> b {
  type: @service
  text: "B"
  layer: @r1
}

<edge> a-b {
  from: @a
  to: @b
  type: @call
}

<edge> a-b-2 {
  from: @a
  to: @b
  type: @call
}

<label> a-b-2-label {
  on: @a-b-2
  text: "retry"
}
