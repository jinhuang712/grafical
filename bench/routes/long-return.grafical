<diagram> {
  format: 1
  title: "long-return"
  density: normal
}

<layer> r0 {
}

<layer> r1 {
}

<layer> r2 {
}

<layer> r3 {
}

<layer> r4 {
}

<order> layers {
  of: @diagram
  axis: down
  items:
    @r0
    @r1
    @r2
    @r3
    @r4
}

<order> r0-order {
  of: @r0
  axis: across
  items:
    @a
}

<order> r1-order {
  of: @r1
  axis: across
  items:
    @b
}

<order> r2-order {
  of: @r2
  axis: across
  items:
    @c
}

<order> r3-order {
  of: @r3
  axis: across
  items:
    @d
}

<order> r4-order {
  of: @r4
  axis: across
  items:
    @e
}

<node> a {
  type: @service
  text: "A"
  layer: @r0
}

<node> b {
  type: @service
  text: "B"
  layer: @r1
}

<node> c {
  type: @service
  text: "C"
  layer: @r2
}

<node> d {
  type: @service
  text: "D"
  layer: @r3
}

<node> e {
  type: @service
  text: "E"
  layer: @r4
}

<edge> a->b {
  from: @a
  to: @b
  type: @call
}

<edge> b->c {
  from: @b
  to: @c
  type: @call
}

<edge> c->d {
  from: @c
  to: @d
  type: @call
}

<edge> d->e {
  from: @d
  to: @e
  type: @call
}

<edge> e->a {
  from: @e
  to: @a
  type: @call
}

<edge> d->b {
  from: @d
  to: @b
  type: @call
}
