<diagram> {
  format: 1
  title: "labels-in-gutter"
  density: normal
}

<layer> r0 {
}

<layer> r1 {
}

<order> layers {
  of: @diagram
  axis: down
  items:
    @r0
    @r1
}

<order> r0-order {
  of: @r0
  axis: across
  items:
    @a
    @b
}

<order> r1-order {
  of: @r1
  axis: across
  items:
    @c
    @d
    @e
}

<node> a {
  type: @service
  text: "A"
  layer: @r0
}

<node> b {
  type: @service
  text: "B"
  layer: @r0
}

<node> c {
  type: @service
  text: "C"
  layer: @r1
}

<node> d {
  type: @service
  text: "D"
  layer: @r1
}

<node> e {
  type: @service
  text: "E"
  layer: @r1
}

<edge> a->c {
  from: @a
  to: @c
  type: @call
}

<edge> a->d {
  from: @a
  to: @d
  type: @call
}

<edge> b->d {
  from: @b
  to: @d
  type: @call
}

<edge> b->e {
  from: @b
  to: @e
  type: @call
}

<label> a->c-label {
  on: @a->c
  text: "orders"
}

<label> a->d-label {
  on: @a->d
  text: "payments"
}

<label> b->d-label {
  on: @b->d
  text: "refunds"
}

<label> b->e-label {
  on: @b->e
  text: "stock"
}
