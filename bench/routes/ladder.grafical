<diagram> {
  format: 1
  title: "ladder"
  density: normal
}

<layer> r0 {
}

<layer> r1 {
}

<layer> r2 {
}

<order> layers {
  of: @diagram
  axis: down
  items:
    @r0
    @r1
    @r2
}

<order> r0-order {
  of: @r0
  axis: across
  items:
    @a
    @b
}

<order> r1-order {
  of: @r1
  axis: across
  items:
    @c
    @d
}

<order> r2-order {
  of: @r2
  axis: across
  items:
    @e
    @f
}

<node> a {
  type: @service
  text: "A"
  layer: @r0
}

<node> b {
  type: @service
  text: "B"
  layer: @r0
}

<node> c {
  type: @service
  text: "C"
  layer: @r1
}

<node> d {
  type: @service
  text: "D"
  layer: @r1
}

<node> e {
  type: @service
  text: "E"
  layer: @r2
}

<node> f {
  type: @service
  text: "F"
  layer: @r2
}

<edge> a->c {
  from: @a
  to: @c
  type: @call
}

<edge> c->e {
  from: @c
  to: @e
  type: @call
}

<edge> b->d {
  from: @b
  to: @d
  type: @call
}

<edge> d->f {
  from: @d
  to: @f
  type: @call
}

<edge> a->d {
  from: @a
  to: @d
  type: @call
}

<edge> c->f {
  from: @c
  to: @f
  type: @call
}

<edge> e->b {
  from: @e
  to: @b
  type: @call
}
