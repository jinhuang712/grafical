<diagram> {
  format: 1
  title: "return-line"
  density: normal
}

<layer> r0 {
}

<layer> r1 {
}

<layer> r2 {
}

<order> layers {
  of: @diagram
  axis: down
  items:
    @r0
    @r1
    @r2
}

<order> r0-order {
  of: @r0
  axis: across
  items:
    @a
}

<order> r1-order {
  of: @r1
  axis: across
  items:
    @b
}

<order> r2-order {
  of: @r2
  axis: across
  items:
    @c
}

<node> a {
  type: @service
  text: "A"
  layer: @r0
}

<node> b {
  type: @service
  text: "B"
  layer: @r1
}

<node> c {
  type: @service
  text: "C"
  layer: @r2
}

<edge> a->b {
  from: @a
  to: @b
  type: @call
}

<edge> b->c {
  from: @b
  to: @c
  type: @call
}

<edge> c->a {
  from: @c
  to: @a
  type: @call
}
