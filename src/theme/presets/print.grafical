<stylesheet> {
  format: 1
  base: default
  about: "Greys with stronger edges, for paper and documents without colour."
}

<type> diagram {
  muted: #555555
}

<type> title {
  color: #111111
}

<type> subtitle {
  color: #444444
}

<type> note {
  color: #444444
}

<type> legend {
  color: #444444
}

<type> group {
  fill: #f3f3f3
  border: #bdbdbd
  radius: 6
  color: #222222
}

<type> band {
  fill: #fafafa
  border: #d0d0d0
  radius: 6
}

<type> lane {
  border: #bdbdbd
  head-fill: #eeeeee
  color: #222222
}

<type> node {
  radius: 4
  border-width: 1.25
  color: #111111
  sublabel-color: #444444
}

<type> service {
  border: #555555
}

<type> store {
  fill: #eeeeee
  border: #555555
}

<type> queue {
  fill: #f7f7f7
  border: #555555
}

<type> external {
  border: #777777
}

<type> actor {
  fill: #f7f7f7
  border: #555555
}

<type> state {
  border: #555555
  radius: 10
}

<type> terminal {
  fill: #e6e6e6
  border: #333333
}

<type> decision {
  border: #555555
}

<type> initial {
  fill: #111111
  border: #111111
}

<type> final {
  border: #111111
}

<type> choice {
  fill: #e6e6e6
  border: #333333
}

<style> emphasis {
  fill: #e6e6e6
  border: #111111
  border-width: 2
}

<type> edge {
  radius: 4
  label-color: #333333
}

<type> call {
  color: #333333
}

<type> async {
  color: #333333
}

<type> data {
  color: #333333
}

<type> link {
  color: #333333
}

<type> optional {
  color: #333333
}
